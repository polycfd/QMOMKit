[phase_space]
names = d, u, v, w
node_counts = 2, 2, 2, 2
conditioning_order = 0, 1, 2, 3
adaptive_branch_counts = false

[time_integration]
scheme = strang

[time_integration.node_advection]
scheme = rk23

[time_integration.node_advection.adaptive]
relative_tolerance = 1.0e-6
absolute_tolerance = 1.0e-10
initial_step = 1.0e-4
max_step = 1.0e-2
min_step = 1.0e-6

[initial]
type = independent_product
number_density = 1.0

[initial.dimension.0]
family = lognormal
mu_log = -9.210340371976184
sigma_log = 0.12

[initial.dimension.1]
family = normal
mean = 0.0
standard_deviation = 0.5

[initial.dimension.2]
family = normal
mean = 0.0
standard_deviation = 0.5

[initial.dimension.3]
family = normal
mean = 0.0
standard_deviation = 0.5

[output]
directory = output
write_moments = true
write_quadrature = true
interval = 0.01
