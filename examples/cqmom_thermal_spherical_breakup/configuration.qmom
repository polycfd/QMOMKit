[phase_space]
names = V, T, u, v, w
node_counts = 2, 2, 2, 2, 2
conditioning_order = 0, 1, 2, 3, 4
adaptive_branch_counts = false

[qmom]
adaptive = false

[cqmom]
moment_storage = lean
diagnostic_level = basic

[vandermonde]
solver = automatic

[time_integration]
scheme = strang

[time_integration.node_advection]
scheme = rk23

[time_integration.node_advection.adaptive]
relative_tolerance = 1.0e-6
absolute_tolerance = 1.0e-10
initial_step = 1.0e-4
max_step = 4.0e-3
min_step = 1.0e-10

[initial]
type = independent_product
number_density = 1.0

[initial.dimension.0]
family = lognormal
mu_log = -28.278651581805676
sigma_log = 0.36

[initial.dimension.1]
family = normal
mean = 350.0
standard_deviation = 4.0

[initial.dimension.2]
family = normal
mean = 0.2
standard_deviation = 0.08

[initial.dimension.3]
family = normal
mean = -0.1
standard_deviation = 0.08

[initial.dimension.4]
family = normal
mean = 0.05
standard_deviation = 0.08

[output]
directory = output
write_moments = true
write_quadrature = true
interval = 0.01
