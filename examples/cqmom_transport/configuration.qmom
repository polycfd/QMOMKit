[phase_space]
names = d, u
node_counts = 2, 2
conditioning_order = 0, 1

[initial]
type = independent_product
number_density = 1.0

[initial.dimension.0]
family = normal
mean = 2.0
standard_deviation = 0.5

[initial.dimension.1]
family = normal
mean = 0.0
standard_deviation = 0.5

[time_integration.node_advection]
scheme = ssp_rk3

[output]
directory = output
write_moments = true
write_quadrature = true
interval = 0.1
