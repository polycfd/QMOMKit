# One-dimensional GQMOM case of droplet volumes, shared by the QMOMKit run and
# its Monte Carlo companion. Both sample this same distribution, so their runs
# start from an identical population. main.cpp evolves the same case with
# classical QMOM for comparison.

[phase_space]
names = V
# N: the moments m0..m(2N) are evolved.
node_counts = 2
qmom_family = generalized
# N_G: the number of nodes of the GQMOM quadrature, which must exceed N.
generalized_node_counts = 20
# The gamma continuation is for a number density on [0, inf), as volumes are.
generalized_continuation = gamma

[initial]
# Without maximum_order, QMOMKit generates m0..m(2N), the moments GQMOM reads.
type = distribution
family = gamma
number_density = 1.0
shape = 4.0
scale = 0.75

# Output is driver-controlled: QMOMKit writes nothing unless the example wires
# these settings into its writers.
[output]
directory = output
write_moments = true
write_quadrature = true
# Simulated-time interval between writes, not a step count.
interval = 1.0
