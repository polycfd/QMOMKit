# GQMOM reconstruction of the trimodal number density of Fox, Laurent &
# Passalacqua (2023), section 4.1 and Fig. 5.
# Every key below is documented in docs/user/8_reference.md.

[phase_space]
names = xi
# N: GQMOM reads the moments m0..m(2N). Set 6 or 9 for the other curves of
# Fig. 5.
node_counts = 3
qmom_family = generalized
# N_G: the number of nodes of the GQMOM quadrature, which must exceed N.
generalized_node_counts = 101

[initial]
# Without maximum_order, QMOMKit generates m0..m(2N), the moments GQMOM reads.
type = mixture

# Three normal components of equal number density, 1/3 each.
[initial.mixture.component.0]
family = normal
number_density = 0.3333333333333333
mean = -3
standard_deviation = 0.1

[initial.mixture.component.1]
family = normal
number_density = 0.3333333333333333
mean = 0
standard_deviation = 0.05

[initial.mixture.component.2]
family = normal
number_density = 0.3333333333333333
mean = 4
standard_deviation = 0.03333333333333333

[output]
directory = output
write_quadrature = true
