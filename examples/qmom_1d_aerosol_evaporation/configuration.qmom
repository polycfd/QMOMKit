# One-dimensional QMOM case for an evaporating aerosol, initialized from a
# three-mode lognormal size distribution.

# The number of coordinates decides the method: one uses QMOM, several CQMOM.
# Coordinate names are labels only; QMOMKit reads no physics from them.
[phase_space]
names = d
# Quadrature nodes per coordinate. An n-node rule needs the moments m0..m(2n-1),
# so raising this asks for more information from the initial condition.
node_counts = 6

# Keep all six nodes. Adaptive inversion, the default, would drop the node of
# the coarse-mode tail, whose weight is about 1e-13 of the largest.
[qmom]
adaptive = false

[initial]
# Component densities are absolute, not fractions: m0 is their sum.
type = mixture

[initial.mixture.component.0]
family = lognormal
number_density = 8.7e4
mu_log = 0.47000362924573563
sigma_log = 0.22314355131420976

[initial.mixture.component.1]
family = lognormal
number_density = 1.2e5
mu_log = 0.53062825106217041
sigma_log = 0.51879379341516751

[initial.mixture.component.2]
family = lognormal
number_density = 1.6e4
mu_log = 4.8121843553724173
sigma_log = 0.60813380623298863

# Output is driver-controlled: QMOMKit writes nothing unless the example wires
# these settings into its writers.
[output]
directory = output
write_moments = true
write_quadrature = true
# Simulated-time interval between writes, not a step count.
interval = 2.0
