[phase_space]
names = d
node_counts = 3

[initial]
type = mixture
maximum_order = 5

[initial.mixture.component.0]
family = normal
number_density = 0.5
mean = 1.0
standard_deviation = 0.1

[initial.mixture.component.1]
family = normal
number_density = 0.5
mean = 3.0
standard_deviation = 0.2

[output]
directory = output
write_moments = true
write_quadrature = true
interval = 0.1
