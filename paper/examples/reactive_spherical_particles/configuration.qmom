[phase_space]
names = d, u, v, w, T
node_counts = 3, 3, 3, 3, 3
conditioning_order = 0, 4, 1, 2, 3
adaptive_branch_counts = true


[time_integration]
scheme = strang

[time_integration.node_advection]
scheme = rk23

[time_integration.node_advection.adaptive]
relative_tolerance = 1.0e-6
absolute_tolerance = 1.0e-9
initial_step = 1.0e-3
max_step = 1.0e-2
min_step = 1.0e-9


[initial]
type = independent_product
number_density = 1.0

[initial.dimension.0]
family = lognormal
mu_log = -8.3253
sigma_log = 0.25

[initial.dimension.1]
family = normal
mean = 0.0
standard_deviation = 0.2

[initial.dimension.2]
family = normal
mean = 0.0
standard_deviation = 0.2

[initial.dimension.3]
family = normal
mean = 0.0
standard_deviation = 0.2

[initial.dimension.4]
family = gamma
shape = 189.0625
scale = 0.002909090909090909

[output]
directory = output
write_moments = true
write_quadrature = true
