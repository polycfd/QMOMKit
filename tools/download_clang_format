#
# This script downloads and installs the clang-format binary. The
# destination directory is
#   [tools]/programs/clang-<SERIES>/bin.
#
# This script only works on Linux (x86_64, aarch64) and macOS (Intel and
# Apple silicon). For other architectures it is necessary to install a
# clang-format 22.1 binary by hand and to point QMOMKIT_CLANG_FORMAT at it.
#

# The exact patch release that is downloaded, and the minor series that
# tools/indent_common.sh enforces. Both must agree on the series.
VERSION="22.1.8"
SERIES="22.1"

PRG="$(cd "$(dirname "$0")" && pwd)/programs"
CLANG_PATH="${PRG}/clang-${SERIES}"

URL="https://files.pythonhosted.org/packages"

# Find out which kind of OS and architecture we are running on and set the
# appropriate settings. The paths below are the PyPI download URLs of the
# clang-format ${VERSION} wheels; the checksums are the ones published on
# https://pypi.org/pypi/clang-format/json.
ARCH="$(uname -m)"
case "${OSTYPE}" in
  linux*)
    CHECKSUM_CMD="sha256sum"
    case "${ARCH}" in
      x86_64)
        FILENAME="clang_format-${VERSION}-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl"
        SUBPATH="e5/88/b82c066fa807da4ca2518fecf79071361f6324b77375e5e92c059c0697fd"
        CHECKSUM="b00cff6bfd1f1686f073a4fdf1cb937dbd58bf7510c659477805c03afdea0816  $FILENAME"
        ;;
      aarch64|arm64)
        FILENAME="clang_format-${VERSION}-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl"
        SUBPATH="50/25/a9734da014eecc1f54c051ad643a28f2f6643dcc812ac59320e80e2b1a3b"
        CHECKSUM="48c3b8dcfe9d4e964ced0e744e0f1f8ddc711bce92e50f6cab21e10f54857d08  $FILENAME"
        ;;
      *)
        echo "unsupported architecture: ${ARCH}"
        exit 1
        ;;
    esac
    ;;
  darwin*)
    CHECKSUM_CMD="shasum -a 256"
    if [[ "${ARCH}" == "arm64" ]]; then
      FILENAME="clang_format-${VERSION}-py2.py3-none-macosx_11_0_arm64.whl"
      SUBPATH="2e/55/539cc1036dae16659f50500ca34838cc5b16cd3e98e3faaf164186b98093"
      CHECKSUM="d1147107222c0dda3e4869e9e8c4a79f9ed1de83819e5274de42b82adf3d2129  $FILENAME"
    else
      FILENAME="clang_format-${VERSION}-py2.py3-none-macosx_10_9_x86_64.whl"
      SUBPATH="5d/d8/29b9db6098da1a011ca3f7560c3942fa81404dbbb4367c3bd1d5c435da3b"
      CHECKSUM="fc2ac5bd0ea41af49968fb69426207806d5f7016cb8f4bfbd44f4f1ffe8d53f2  $FILENAME"
    fi
    ;;
  *)
    echo "unknown: ${OSTYPE}"
    exit 1
    ;;
esac

if [ ! -d "${PRG}" ]
then
    echo "create folder ${PRG}"
    mkdir -p "${PRG}"
fi

if [ -d "${CLANG_PATH}" ]
then
    echo "${CLANG_PATH}  exists. Exiting."
    exit 1
fi

echo "Downloading and installing clang-format-${VERSION} from ${URL}/${SUBPATH}/${FILENAME}"
mkdir -p "${CLANG_PATH}/bin"

tmpdir="${TMPDIR:-/tmp}/qmomkitclang${RANDOM}${RANDOM}"
mkdir -p "${tmpdir}"
cd "${tmpdir}"
if [ -x "$(command -v wget)" ]; then
  echo "Using wget to download..."
  # set progress option if available
  wget --help | grep -q '\--show-progress' && \
        _PROGRESS_OPT="--show-progress" || _PROGRESS_OPT=""

  wget -q $_PROGRESS_OPT -L "${URL}/${SUBPATH}/${FILENAME}" > /dev/null
else
  if [ -x "$(command -v curl)" ]; then
    echo "Using curl to download..."
    curl --progress-bar -L "${URL}/${SUBPATH}/${FILENAME}" -O > /dev/null
  else
    echo "Error: Neither wget nor curl is available..."
    exit 1
  fi
fi

if echo "${CHECKSUM}" | ${CHECKSUM_CMD} -c; then
  #
  # A wheel is a plain zip archive that carries the binary in
  # clang_format/data/bin/clang-format. Extract just that file. Prefer
  # 'unzip', but fall back to Python, which is guaranteed to be able to
  # read a wheel.
  #
  if [ -x "$(command -v unzip)" ]; then
    unzip -q -j "${FILENAME}" "clang_format/data/bin/clang-format" \
      -d "${CLANG_PATH}/bin"
  elif [ -x "$(command -v python3)" ]; then
    python3 -c "import shutil, sys, zipfile
with zipfile.ZipFile(sys.argv[1]) as archive, \
     archive.open('clang_format/data/bin/clang-format') as source, \
     open(sys.argv[2], 'wb') as target:
    shutil.copyfileobj(source, target)" \
      "${FILENAME}" "${CLANG_PATH}/bin/clang-format"
  else
    echo "Error: Neither unzip nor python3 is available..."
    rm -r "${CLANG_PATH}"
    exit 1
  fi
  chmod 755 "${CLANG_PATH}/bin/clang-format"
else
  echo "*** The downloaded file has the wrong SHA256 checksum!"
  rm -r "${CLANG_PATH}"
  exit 1
fi
rm -r "${tmpdir}"

echo "All done. clang-format successfully installed into"
echo "    ${CLANG_PATH}/bin"
