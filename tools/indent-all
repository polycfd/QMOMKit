#
# This script indents all source files of QMOMKit according to our usual
# code formatting standards. It is used to ensure that our code base looks
# uniform, as uniformity helps make code easier to read.
#
# While we're already touching every file, this script also makes
# sure we set permissions correctly and checks for correct unix-style line
# endings.
#
# The script needs to be executed as
#   ./tools/indent-all
# from the top-level directory of the source tree.
#
# The script can be invoked with QMOMKIT_CLANG_FORMAT to change
# the default version of clang-format. For example:
#   QMOMKIT_CLANG_FORMAT=clang-format-22 ./tools/indent-all
#
# Note: If the script is invoked with REPORT_ONLY=true set,
#   REPORT_ONLY=true ./tools/indent-all
# then indentation errors will only be reported without any actual file
# changes.
#

if [ ! -f tools/indent-all ]; then
  echo "*** This script must be run from the top-level directory of QMOMKit."
  exit 1
fi

if [ ! -f tools/indent_common.sh ]; then
  echo "*** This script requires tools/indent_common.sh."
  exit 1
fi

source tools/indent_common.sh

#
# Run sanity checks:
#

checks

#
# The directories that hold source code, and the files within them that are
# subject to our formatting standards:
#

SOURCE_DIRECTORIES="include src tests examples tools"
SOURCE_FILES=".*\.(cpp|hpp)"

#
# Process all source and header files:
#

process "${SOURCE_DIRECTORIES}" "${SOURCE_FILES}" format_file

#
# Fix permissions and convert to unix line ending if necessary:
#

process "${SOURCE_DIRECTORIES}" "${SOURCE_FILES}" fix_permissions

process "${SOURCE_DIRECTORIES}" "${SOURCE_FILES}" dos_to_unix

#
# Removing trailing whitespace
#

process "${SOURCE_DIRECTORIES}" "${SOURCE_FILES}" remove_trailing_whitespace

#
# Ensure only a single newline at end of files
#

process "${SOURCE_DIRECTORIES}" "${SOURCE_FILES}" ensure_single_trailing_newline
