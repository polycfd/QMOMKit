@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The QMOMKit this companion was built against, or a newer one of the same major
# version. find_dependency passes on whether the companion itself is required.
find_dependency(QMOMKit @QMOMKit_VERSION@ CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/QMOMKitMonteCarloTargets.cmake")

check_required_components(QMOMKitMonteCarlo)
