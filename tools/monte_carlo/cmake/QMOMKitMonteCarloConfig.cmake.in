@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Exactly the QMOMKit this companion was built against: the companion is a
# static C++ library compiled against that version's headers, and a later
# version may change the layout of the types they share. find_dependency passes
# on whether the companion itself is required.
find_dependency(QMOMKit @QMOMKit_VERSION@ EXACT CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/QMOMKitMonteCarloTargets.cmake")

check_required_components(QMOMKitMonteCarlo)
